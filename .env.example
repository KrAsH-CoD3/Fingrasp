# ── Database Configuration ──
# MongoDB connection URI (required in production)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=YourApp
# Database name
DB_NAME=fingrasp

# ── Environment ──
# Enable debug mode (true/false)
DEBUG=true
# Enable strict security mode for production (true/false)
# When true, enables HSTS and HTTPS-only rules
STRICT_SECURITY=false

# ── CORS Configuration ──
# Comma-separated list of domains allowed to make requests to the API
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Rate Limiting ──
# Rate limit for fingerprint save endpoint
RATE_LIMIT_SAVE=1/minute
# Rate limit for general API endpoints
RATE_LIMIT_API=5/minute
# Rate limit for frontend serving
RATE_LIMIT_FRONTEND=30/minute
# Rate limit for static files
RATE_LIMIT_STATIC=30/minute

# ── IP Privacy ──
# Anonymize IP addresses before saving to database (true/false)
# When true, last octet of IPv4 or last 80 bits of IPv6 is zeroed
ANONYMIZE_IP=true

# ── Cloudflare Turnstile (CAPTCHA) ──
# Get these from https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Application Configuration ──
# Base URL of the application
BASE_URL=http://localhost:8000

# ── MongoDB Collection Names ──
# Collection for storing fingerprints
FINGERPRINT_COLLECTION_NAME=fingerprints
# Collection for temporary session data
TEMP_SESSION_COLLECTION_NAME=temp_sessions
# Collection for statistics counters
COUNTERS_COLLECTION_NAME=stats_counters
# Temporary session expiry time in minutes
TEMP_SESSION_EXPIRY_MINUTES=5

# ── External API Configuration ──
# Timeout for external API requests (e.g., Turnstile siteverify)
API_TIMEOUT=15.0
